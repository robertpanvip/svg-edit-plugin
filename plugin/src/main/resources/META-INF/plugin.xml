<idea-plugin>
    <id>com.pan.svg</id>
    <name>SVG Editor</name>
    <version>0.1.0</version>
    <vendor email="robertpanvip@163.com" url="https://github.com/robertpanvip/svg-edit-plugin.git">PAN</vendor>
    <description>SVG editor with an interactive design canvas (move / resize / rotate) alongside the
        source text. Opens as a tab next to the built-in SVG image viewer.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="SVG Editor"
                    anchor="right"
                    factoryClass="com.pan.svg.plugin.SvgEditorToolWindowFactory"/>
        <fileEditorProvider implementation="com.pan.svg.plugin.SvgPreviewEditorProvider"
                            order="last"/>
    </extensions>

    <actions>
        <action id="SvgEasy.OpenInDesigner"
                class="com.pan.svg.plugin.OpenInSvgEasyAction"
                text="Open in SvgEasy Designer"
                description="Open the SVG file in the SvgEasy text + design-canvas editor">
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
