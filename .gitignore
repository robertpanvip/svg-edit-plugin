# Build outputs
.gradle/
build/
out/
!gradle/wrapper/

# Native build artifacts
native/*/target/
*.dll
*.so
*.dylib

# The SVGO bundle's build inputs (native/svgo_bundle) fetch esbuild + svgo; the artefact they
# produce is committed, so the toolchain itself is not.
node_modules/

# Local tooling (Gradle distribution downloaded for local runs)
.tooling/

# IDE
.idea/
*.iml

# Local project memory / tooling state (not part of the source)
.workbuddy/
*.bak

# Headless drag-test artefacts
dragtest_*.png
app/dragtest_*.png
.uploads/
